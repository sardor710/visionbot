# Telegram API credentials from https://my.telegram.org
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789

# Optional: Your personal account phone number (with country code) for user session
TELEGRAM_PHONE=+1234567890

# Optional: If you want to operate via Bot API token
TELEGRAM_BOT_TOKEN=1234567890:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Name of the session file to persist authentication
TELEGRAM_SESSION_NAME=user_account_session

# Directory to save downloaded media and metadata JSON files
DOWNLOAD_DIR=downloads
